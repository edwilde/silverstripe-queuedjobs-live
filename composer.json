{
    "name": "edwilde/silverstripe-queuedjobs-live",
    "description": "Live updates for Silverstripe Queued Jobs admin panel",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "queuedjobs", "live-updates"],
    "license": "BSD-3-Clause",
    "require": {
        "silverstripe/framework": "^6.0",
        "symbiote/silverstripe-queuedjobs": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "EdWilde\\QueuedJobsLive\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EdWilde\\QueuedJobsLive\\Tests\\": "tests/php/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
